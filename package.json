{
  "name": "cliplink",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=24.16"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test",
    "build:e2e": "E2E=1 astro build",
    "start:e2e": "node ./dist/server/entry.mjs",
    "db:dev": "docker compose up -d --wait db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.13",
    "@astrojs/react": "^7.1.9",
    "@astrojs/vercel": "^11.0.22",
    "@neondatabase/serverless": "^1.2.1",
    "@tailwindcss/vite": "^4.3.5",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "astro": "^7.4.12",
    "better-auth": "^1.7.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.73.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@electric-sql/pglite": "^0.5.16",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "simple-git-hooks"
    ]
  }
}
