# Postgres. Locally, `pnpm db:dev` starts this database in Docker on port 5433
# (set DB_PORT to change it). On Vercel the Neon integration sets both values.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/cliplink
# Direct (unpooled) connection, used by drizzle-kit for migrations. Optional locally.
DATABASE_URL_UNPOOLED=

# Better Auth. The base URL is where the app runs (https://cliplink.app in production).
BETTER_AUTH_URL=http://localhost:4321
# 32+ random characters, different per environment: `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Development OAuth apps (never the production ones). Callback URLs:
#   http://localhost:4321/api/auth/callback/google
#   http://localhost:4321/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
