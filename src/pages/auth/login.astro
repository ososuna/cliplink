---
import SignInButtons from '@/components/auth/SignInButtons';
import HomeLayout from '@/components/layout/HomeLayout.astro';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import { signInErrorMessage } from '@/auth';

const error = Astro.url.searchParams.get('error');
const message = error ? signInErrorMessage(error) : null;
---

<HomeLayout>
  <Card className="mx-4 w-full max-w-sm">
    <CardHeader>
      <CardTitle>
        <h1 class="text-center text-2xl font-semibold tracking-tight">
          Log in to your account
        </h1>
      </CardTitle>
    </CardHeader>
    <CardContent className="flex flex-col gap-4">
      {message && (
        <p
          role="alert"
          class="rounded-md border border-destructive/50 px-4 py-3 text-sm text-destructive"
        >
          {message}
        </p>
      )}
      <SignInButtons client:load />
    </CardContent>
  </Card>
</HomeLayout>
