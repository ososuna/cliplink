---
import { LogIn } from 'lucide-react';
import UserMenu from '@/components/auth/UserMenu';
import Logo from '@/components/layout/Logo.astro';
import ModeToggle from '@/components/layout/ModeToggle';
import { buttonVariants } from '@/components/ui/button';
import { Skeleton } from '@/components/ui/skeleton';
import { signInPath } from '@/paths';

const { user } = Astro.locals;
---

<header
  transition:persist
  class="sticky top-0 z-50 w-full bg-background transition-all duration-300 ease-in-out"
>
  <div class="container mx-auto px-4">
    <div class="flex h-12 items-center justify-between">
      <div class="text-lg font-bold">
        <Logo class="h-8 w-8" />
      </div>
      <nav class="flex items-center justify-center gap-x-4">
        {user ? (
          <UserMenu
            client:only="react"
            name={user.name}
            image={user.image ?? null}
          >
            <Skeleton slot="fallback" className="h-8 w-8 rounded-full" />
          </UserMenu>
        ) : (
          <a href={signInPath} class={buttonVariants({ variant: 'ghost' })}>
            <LogIn /> Log in
          </a>
        )}
        <ModeToggle client:only="react">
          <Skeleton slot="fallback" className="h-9 w-9 rounded-md" />
        </ModeToggle>
      </nav>
    </div>
  </div>
</header>
