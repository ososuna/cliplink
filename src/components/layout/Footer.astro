---
import { Heart } from 'lucide-react';
import Logo from '@/components/layout/Logo.astro';
---

<footer class="border-t bg-background">
  <div class="container mx-auto px-4 py-8 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center justify-between space-y-4 md:flex-row md:space-y-0">
      <div class="flex flex-col items-center space-y-2 md:items-start">
        <p class="font-semibold">
          <Logo class="h-8 w-8" />
        </p>
        <nav>
          <ul class="flex flex-wrap justify-center space-x-4 md:justify-start">
            <li>
              <a
                href="/privacy-policy"
                class="text-sm text-muted-foreground transition-colors hover:text-primary"
              >
                Privacy Policy
              </a>
            </li>
            <li>
              <a
                href="/terms-of-service"
                class="text-sm text-muted-foreground transition-colors hover:text-primary"
              >
                Terms of Service
              </a>
            </li>
          </ul>
        </nav>
      </div>
      <div class="flex items-center space-x-1 text-sm font-medium text-muted-foreground">
        <span>Made with</span>
        <Heart className="h-4 w-4 fill-current text-red-500" />
        <a href="https://oswaldo-osuna.com" target="_blank">
          by Oswaldo Osuna
        </a>
      </div>
    </div>
  </div>
</footer>
