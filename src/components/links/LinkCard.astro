---
import { ExternalLink } from 'lucide-react';
import CopyButton from '@/components/links/CopyButton';
import DeleteLinkDialog from '@/components/links/DeleteLinkDialog';
import RenameLinkDialog from '@/components/links/RenameLinkDialog';
import { buttonVariants } from '@/components/ui/button';
import {
  Card,
  CardDescription,
  CardFooter,
  CardHeader,
} from '@/components/ui/card';
import { linkPath, linkUrl, type Link } from '@/links';

interface Props {
  link: Link;
}

const { link } = Astro.props;
const shortUrl = linkUrl({ code: link.code, origin: Astro.url.origin });
const path = linkPath(link.code);
---

<article>
  <Card className="h-full">
    <CardHeader className="grid-cols-1">
      <div class="flex min-w-0 items-center gap-2">
        <h2
          class="min-w-0 flex-1 truncate text-lg leading-none font-semibold"
          title={link.name ?? path}
        >
          {link.name ?? path}
        </h2>
        {link.name && (
          <span class="shrink-0 text-sm text-muted-foreground">{path}</span>
        )}
      </div>
      <CardDescription className="truncate" title={link.destination}>
        {link.destination}
      </CardDescription>
    </CardHeader>
    <CardFooter className="mt-auto flex gap-2">
      <CopyButton client:load url={shortUrl} />
      <a
        href={link.destination}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Navigate"
        class={buttonVariants({ variant: 'outline', size: 'icon' })}
      >
        <ExternalLink />
      </a>
      <RenameLinkDialog client:load linkId={link.id} name={link.name} />
      <DeleteLinkDialog client:load linkId={link.id} />
    </CardFooter>
  </Card>
</article>
